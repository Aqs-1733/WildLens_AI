# Application
APP_NAME=识境
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010
FRONTEND_URL=http://127.0.0.1:5174
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REGULATOR_INVITE_CODE=WILD-REG-2026
POSTGRES_PASSWORD=replace-with-a-database-password
WILDLENS_DB_PATH=./storage/wildlens.db
DATABASE_URL=
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,capacitor://localhost,http://localhost

# AI / ARK
ARK_API_KEY=
ARK_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DNS_FALLBACK_IP=
ARK_MODEL=doubao-seed-2-0-lite-260428
ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=
AI_CORRECTION_ENABLED=true
AI_CORRECTION_MIN_CONFIDENCE=0.72
AI_CORRECTION_STATUSES=review,unknown,fallback,probable

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Shijing-AI
LANGSMITH_API_KEY=

# Photo, video and models
MAX_UPLOAD_MB=1024
MAX_PHOTO_MB=20
VIDEO_SAMPLE_FPS=2
SPECIES_QUEUE_DB_PATH=./storage/species_image_bank.sqlite
SPECIES_EMBEDDING_DB_PATH=./storage/species_visual_embeddings.sqlite
GLOBAL_SPECIES_INDEX_PATH=./models/metadata/global_species_index
SPECIES_IMAGE_ROOT=/root/autodl-tmp/datasets/wildlens_species_bank/curated/inaturalist
INAT_DWCA_PATH=/root/autodl-tmp/datasets/inaturalist_dwca/gbif-observations-dwca.zip
CATALOGUE_OF_LIFE_PATH=./data/raw/catalogue_of_life_2026-06-19_XR_ColDP.zip
MODEL_REGISTRY_DIR=./models/registry
MODEL_CHECKPOINT_DIR=./models/checkpoints
ACTIVE_MODEL_CONFIG=./models/registry/active_model.json
SAMPLE_MEDIA_DIR=./data/sample_videos
OUTPUT_MEDIA_DIR=./storage/outputs
REPORT_OUTPUT_DIR=./storage/reports
UPLOAD_DIR=./storage/uploads
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VISION_MODE=hybrid
YOLO_MODEL_PATH=./models/pretrained/yolo11n.onnx
CUSTOM_WILDLIFE_MODEL_PATH=./models/onnx/wildlife_species.onnx
FIRE_SMOKE_MODEL_PATH=./models/onnx/fire_smoke.onnx
BEHAVIOR_MODEL_PATH=./models/onnx/animal_behavior.onnx
PHENOMENA_MODEL_PATH=./models/onnx/natural_phenomena.onnx
DETECTION_CONFIDENCE=0.35
PLANT_MIN_AREA_RATIO=0.035

# SpeciesNet is isolated in its own Python environment and called over HTTP.
# Do not install SpeciesNet into the main app environment.
SPECIESNET_ENABLED=true
SPECIESNET_API_URL=http://127.0.0.1:8101
SPECIESNET_TIMEOUT_SECONDS=120
SPECIESNET_CONNECT_TIMEOUT_SECONDS=5
SPECIESNET_READ_TIMEOUT_SECONDS=120
SPECIESNET_WRITE_TIMEOUT_SECONDS=30
SPECIESNET_POOL_TIMEOUT_SECONDS=5
SPECIESNET_MIN_SCORE=0.65
SPECIESNET_STRONG_SCORE=0.90
SPECIESNET_CACHE_ENABLED=true
SPECIESNET_MODEL_NAME=kaggle:google/speciesnet/pyTorch/v4.0.3a/1
SPECIESNET_MODEL_VERSION=4.0.3a
SPECIESNET_API_PYTHON=./.venv-speciesnet-cpu/Scripts/python.exe
SPECIESNET_API_HOST=127.0.0.1
SPECIESNET_API_PORT=8101
SPECIESNET_MAX_IMAGE_MB=25
SPECIESNET_CACHE_DIR=./storage/speciesnet_cache
KAGGLEHUB_CACHE=./models/speciesnet_offline
CUDA_VISIBLE_DEVICES=-1

# BioCLIP compact prototype engine. These paths point at the migrated pack;
# do not copy the SQLite database or model cache into another directory.
BIOCLIP_ENABLED=true
BIOCLIP_MODEL_ID=hf-hub:imageomics/bioclip
BIOCLIP_EMBEDDING_DIM=512
BIOCLIP_HF_HOME=./storage/cloud_migration/wildlens_compact_prototype_pack/models/hf_cache
BIOCLIP_PROTOTYPE_DB_PATH=./storage/cloud_migration/wildlens_compact_prototype_pack/storage/species_prototypes_inference.sqlite
BIOCLIP_DEVICE=cpu
BIOCLIP_TOP_K=10
BIOCLIP_BATCH_SIZE=16384
BIOCLIP_SEARCH_BACKEND=memory
BIOCLIP_INDEX_DTYPE=float16
BIOCLIP_PRELOAD_INDEX=true
BIOCLIP_PRELOAD_MODEL=true
BIOCLIP_QUERY_CACHE_SIZE=128
BIOCLIP_FULL_IMAGE_FALLBACK=true
BIOCLIP_FULL_IMAGE_FALLBACK_WEAK_ONLY=true
BIOCLIP_MIN_SIMILARITY=0.55
BIOCLIP_STRONG_SIMILARITY=0.78
BIOCLIP_MIN_MARGIN=0.01

# Local active-learning correction memory. Stores compact 512-d embeddings only,
# not original downloaded/user images.
ACTIVE_LEARNING_ENABLED=true
ACTIVE_LEARNING_RUNTIME_ENABLED=true
ACTIVE_LEARNING_EMBEDDING_DB_PATH=./storage/active_learning/streamed_embeddings.sqlite
ACTIVE_LEARNING_MIN_SIMILARITY=0.86
ACTIVE_LEARNING_SUPPORTED_MIN_SIMILARITY=0.80
ACTIVE_LEARNING_MIN_MARGIN=0.04
ACTIVE_LEARNING_MIN_SUPPORT=2
ACTIVE_LEARNING_ACCEPT_MIN_CONFIDENCE=0.78
HF_HOME=./storage/cloud_migration/wildlens_compact_prototype_pack/models/hf_cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional services
REDIS_URL=redis://localhost:6379/0
